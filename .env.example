DATABASE_URL=postgresql://sre_agent:sre_agent@localhost:5432/sre_agent
NEW_RELIC_API_KEY=
NEW_RELIC_GRAPHQL_URL=https://api.newrelic.com/graphql
PROMETHEUS_URL=https://prometheus.pro.mymyhub.com
S3_BUCKET=sre-agent-data
S3_PREFIX=dev
DATA_WINDOW_DAYS=30
DATA_WINDOW_SIZE=15m
DAILY_BACKFILL_LOOKBACK_HOURS=48

# SRE agent service / runner
SRE_AGENT_RUNNER_ENABLED=true
SRE_AGENT_RUNNER_INTERVAL_SECONDS=900
SRE_AGENT_LOOKBACK_MINUTES=60
SRE_AGENT_WINDOW_SIZE=15m
SRE_AGENT_COLLECT_BATCH_SIZE=20
SRE_AGENT_COLLECTION_TIMEOUT_SECONDS=300
SRE_AGENT_SKIP_GITHUB=true
SRE_AGENT_SKIP_KUBERNETES=false
SRE_AGENT_BACKFILL_SKIP_KUBERNETES=true
SRE_AGENT_SKIP_KUBERNETES_EVENTS=false
SRE_AGENT_KUBERNETES_EVENTS_PROVIDER=auto
SRE_AGENT_KUBECTL_TIMEOUT_SECONDS=15
SRE_AGENT_MARK_ANOMALIES_AFTER_COLLECTION=true
SRE_AGENT_GAP_RECOVERY_ENABLED=true
SRE_AGENT_GAP_LOOKBACK_HOURS=24
SRE_AGENT_GAP_MAX_WINDOWS_PER_RUN=8
SRE_AGENT_GAP_SERVICE_CHUNK_SIZE=20
SRE_AGENT_GAP_RECOVERY_ORDER=newest

# Standalone historical gap backfill. Run scripts/historical_gap_backfill.py
# from cron or a Kubernetes CronJob; do not put long historical recovery inside
# the service runner.
SRE_AGENT_HISTORICAL_BACKFILL_DAYS=15
SRE_AGENT_HISTORICAL_BACKFILL_EXCLUDE_RECENT_HOURS=24
SRE_AGENT_HISTORICAL_BACKFILL_MAX_RANGE_HOURS=24

# Local Kubernetes access for storehub-pro through jumpserver SOCKS tunnel.
# Start the tunnel separately before running the service locally:
# ssh -i /Users/storehub/.ssh/jumpserver.pem -N -D 127.0.0.1:1080 root@54.169.8.128
KUBECTL_AWS_PROFILE=pro
KUBECTL_PROXY_URL=socks5://127.0.0.1:1080

# Optional Kubernetes events from VictoriaLogs. Set
# SRE_AGENT_SKIP_KUBERNETES_EVENTS=false after confirming the LogsQL fields.
VICTORIALOGS_URL=https://log.pro.mymyhub.com
VICTORIALOGS_TENANT=
# The pro stream contains fields such as log_type, namespace, name, reason,
# level, kind, count, _time, and _msg.
VICTORIALOGS_KUBERNETES_EVENTS_QUERY_TEMPLATE=log_type:k8s_events namespace:{namespace} name:~"{workload_name}-.+"
